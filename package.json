{
  "name": "intelligent-document-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Intelligent Document Processor with separate frontend and backend",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=idp-backend",
    "dev:frontend": "npm run dev --workspace=idp-frontend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=idp-backend",
    "build:frontend": "npm run build --workspace=idp-frontend",
    "test": "npm run test --workspace=idp-backend",
    "start:backend": "npm run start --workspace=idp-backend",
    "preview:frontend": "npm run preview --workspace=idp-frontend"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
